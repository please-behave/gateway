{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attestation",
  "description": "Evidence reported by an authenticated gateway sender.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "commit", "execution_points", "overall", "results"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "repository": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "commit": { "type": "string", "minLength": 1, "maxLength": 64 },
    "execution_points": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "rule_sets": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/boundRuleSet" }
    },
    "overall": { "enum": ["PASS", "FAIL", "ERROR"] },
    "results": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "kind": { "enum": ["check", "review", "integrity"] },
          "status": { "enum": ["PASS", "FAIL", "ERROR", "NOT_RUN", "WARN"] },
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path", "id"],
            "dependentRequired": { "version": ["digest"], "digest": ["version"] },
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\\u0000" } },
              "path": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\\u0000" } },
              "id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\\u0000" } },
              "version": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "digest": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\\u0000" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "boundRuleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "id", "version", "execution_points"],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^([^:/@\\[\\]\\\\\\s]+|\\[[0-9a-fA-F:.]+\\])/[^/\\\\\\u0000-\\u001f\\u007f]",
          "not": {
            "pattern": "(\\.git|/)(?![\\s\\S])|[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": { "pattern": "\\u0000" },
          "anyOf": [
            { "const": "." },
            {
              "not": {
                "pattern": "^[/\\\\]|^[A-Za-z]:|//|/(?![\\s\\S])|(^|/)\\.{1,2}(/|(?![\\s\\S]))"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "execution_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "not": { "pattern": "\\u0000" }
          }
        }
      }
    }
  }
}
