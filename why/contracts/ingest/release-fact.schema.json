{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public release fact request",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "version", "commit"],
  "properties": {
    "repository": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/text" },
    "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\\u0000" } }
  }
}
